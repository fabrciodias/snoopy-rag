# Configurações do Google (Drive)
GOOGLE_API_KEY=sua-chave-api-google
GOOGLE_APP_ID=seu-app-id

# Configurações do Supabase (Nuvem)
SUPABASE_URL=https://[SUA-URL].supabase.co
SUPABASE_KEY=sua_anon_key_publica
SUPABASE_SERVICE_KEY=sua_service_role_key_privada

# Chaves de Inteligência Artificial
GEMINI_API_KEY=sua-chave-gemini
GEMINI_LLM_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Configurações do Retrieval
RETRIEVAL_DEFAULT_LIMIT=10
RETRIEVAL_MAX_LIMIT=50

# Configurações do Ambiente
ENVIRONMENT=development
API_PORT=3000