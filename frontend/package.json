{
  "name": "snoopy-rag-frontend",
  "private": true,
  "version": "3.0.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && pm2 startOrRestart ecosystem.config.cjs --env production && pm2 save",
    "stop": "pm2 delete snoopy-rag-v3 && pm2 save",
    "logs": "pm2 logs snoopy-rag-v3",
    "status": "pm2 status"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@supabase/supabase-js": "^2.105.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}